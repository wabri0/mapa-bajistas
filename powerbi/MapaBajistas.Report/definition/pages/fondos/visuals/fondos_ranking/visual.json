{
  "$schema": "https://developer.microsoft.com/json-schemas/fabric/item/report/definition/visualContainer/2.0.0/schema.json",
  "name": "fondos_ranking",
  "position": {
    "x": 900,
    "y": 60,
    "z": 2000,
    "width": 360,
    "height": 625,
    "tabOrder": 2000
  },
  "visual": {
    "visualType": "clusteredBarChart",
    "query": {
      "queryState": {
        "Category": {
          "projections": [
            {
              "field": {
                "Column": {
                  "Expression": {
                    "SourceRef": {
                      "Entity": "dim_fondo"
                    }
                  },
                  "Property": "grupo_gestor"
                }
              },
              "queryRef": "dim_fondo.grupo_gestor",
              "nativeQueryRef": "grupo_gestor",
              "active": true
            }
          ]
        },
        "Y": {
          "projections": [
            {
              "field": {
                "Measure": {
                  "Expression": {
                    "SourceRef": {
                      "Entity": "fact_posicion_diaria"
                    }
                  },
                  "Property": "Empresas con cortos hoy"
                }
              },
              "queryRef": "fact_posicion_diaria.Empresas con cortos hoy",
              "nativeQueryRef": "Empresas con cortos hoy"
            }
          ]
        }
      },
      "sortDefinition": {
        "sort": [
          {
            "field": {
              "Measure": {
                "Expression": {
                  "SourceRef": {
                    "Entity": "fact_posicion_diaria"
                  }
                },
                "Property": "Empresas con cortos hoy"
              }
            },
            "direction": "Descending"
          }
        ],
        "isDefaultSort": true
      }
    },
    "visualContainerObjects": {
      "title": [
        {
          "properties": {
            "show": {
              "expr": {
                "Literal": {
                  "Value": "true"
                }
              }
            },
            "text": {
              "expr": {
                "Literal": {
                  "Value": "'Empresas en corto por gestora'"
                }
              }
            },
            "fontSize": {
              "expr": {
                "Literal": {
                  "Value": "12D"
                }
              }
            }
          }
        }
      ]
    },
    "drillFilterOtherVisuals": true
  }
}
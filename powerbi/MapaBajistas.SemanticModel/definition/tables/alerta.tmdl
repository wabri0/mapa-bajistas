	partition alerta = m
		mode: import
		source =
				let
					Origen = Sql.Database(Servidor, BaseDatos),
					Tabla = Origen{[Schema = "cliente", Item = "alerta"]}[Data],
					Columnas = Table.SelectColumns(Tabla, {"alerta_id", "cliente_id", "emisor_id", "fecha_id", "tipo", "mensaje"}),
					Tipos = Table.TransformColumnTypes(Columnas, {{"alerta_id", Int64.Type}, {"cliente_id", Int64.Type}, {"emisor_id", Int64.Type}, {"fecha_id", Int64.Type}, {"tipo", type text}, {"mensaje", type text}}),
					ConFecha = Table.AddColumn(Tipos, "fecha", each #date(Number.IntegerDivide([fecha_id], 10000), Number.Mod(Number.IntegerDivide([fecha_id], 100), 100), Number.Mod([fecha_id], 100)), type date)
				in
					ConFecha


	partition dim_fecha = m
		mode: import
		source =
				let
					Origen = Sql.Database(Servidor, BaseDatos),
					Tabla = Origen{[Schema = "dw", Item = "dim_fecha"]}[Data],
					Columnas = Table.SelectColumns(Tabla, {"fecha_id", "fecha", "anio", "trimestre", "mes", "nombre_mes", "es_dia_bolsa"}),
					Tipos = Table.TransformColumnTypes(Columnas, {{"fecha_id", Int64.Type}, {"fecha", type date}, {"anio", Int64.Type}, {"trimestre", Int64.Type}, {"mes", Int64.Type}, {"nombre_mes", type text}, {"es_dia_bolsa", type logical}}),

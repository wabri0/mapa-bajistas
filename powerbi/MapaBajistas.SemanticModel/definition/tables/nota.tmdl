	partition nota = m
		mode: import
		source =
				let
					Origen = Sql.Database(Servidor, BaseDatos),
					Tabla = Origen{[Schema = "cliente", Item = "nota"]}[Data],
					Columnas = Table.SelectColumns(Tabla, {"nota_id", "cliente_id", "emisor_id", "fecha_id", "texto", "autor"}),
					Tipos = Table.TransformColumnTypes(Columnas, {{"nota_id", Int64.Type}, {"cliente_id", Int64.Type}, {"emisor_id", Int64.Type}, {"fecha_id", Int64.Type}, {"texto", type text}, {"autor", type text}}),
					ConFecha = Table.AddColumn(Tipos, "fecha", each #date(Number.IntegerDivide([fecha_id], 10000), Number.Mod(Number.IntegerDivide([fecha_id], 100), 100), Number.Mod([fecha_id], 100)), type date)
				in
					ConFecha


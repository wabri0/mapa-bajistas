	partition fact_posicion_diaria = m
		mode: import
		source =
				let
					Origen = Sql.Database(Servidor, BaseDatos),
					Tabla = Origen{[Schema = "dw", Item = "fact_posicion_diaria"]}[Data],
					Columnas = Table.SelectColumns(Tabla, {"emisor_id", "fecha_id", "fondo_id", "pct"}),
					Tipos = Table.TransformColumnTypes(Columnas, {{"emisor_id", Int64.Type}, {"fecha_id", Int64.Type}, {"fondo_id", Int64.Type}, {"pct", type number}})
				in

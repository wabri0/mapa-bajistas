table fact_indicador_diario
	lineageTag: d2180c0f-d8b7-508c-8986-a173a2723c4e

	measure 'Cortas %' = AVERAGEX(VALUES(dim_fecha[fecha_id]), CALCULATE(SUM(fact_indicador_diario[suma_pct])))
		formatString: 0.00
		lineageTag: 65d7f25d-7a15-5394-b313-b2ebf2b1f4c0

	measure 'Cortas máx %' = MAXX(VALUES(dim_fecha[fecha_id]), CALCULATE(SUM(fact_indicador_diario[suma_pct])))
		formatString: 0.00
		lineageTag: 41ff38c4-7b46-51de-a5f8-a828e1522169

	measure 'Fondos con posición' = AVERAGEX(VALUES(dim_fecha[fecha_id]), CALCULATE(SUM(fact_indicador_diario[num_fondos])))
		formatString: 0.0
		lineageTag: 8d4f919a-641a-5e5d-a6ca-e61cfed31f3b

	measure 'Días para cubrir' = AVERAGE(fact_indicador_diario[dias_cubrir])
		formatString: 0.0
		lineageTag: 604f5392-41e1-5a9c-9ffa-8b1fdf45cdc7

	measure 'Color calor' = VAR v = [Cortas %] RETURN SWITCH(TRUE(), ISBLANK(v), BLANK(), v >= 10, "#7F1D1D", v >= 5, "#B91C1C", v >= 3, "#DC2626", v >= 2, "#F87171", v >= 1, "#FCA5A5", v > 0, "#FEE2E2", "#FFFFFF")
		isHidden
		lineageTag: 60fc4328-b093-5fdc-95e3-0ea386715ee2

	measure 'Color texto calor' = IF([Cortas %] >= 3, "#FFFFFF", "#15212C")
		isHidden
		lineageTag: 6eae2ee4-07df-5791-8cc2-bb5e3a51e7ec

